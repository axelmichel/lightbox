// Copy to Local.xcconfig (ignored by git) and fill in your own values.

// Your Team ID: Xcode → Settings → Accounts, or developer.apple.com → Membership details.
DEVELOPMENT_TEAM = YOURTEAMID

// A bundle ID belongs to one team: use your own. The app's data lives in the sandbox
// container of this ID, so keep it once set.
PRODUCT_BUNDLE_IDENTIFIER = com.example.lightbox
